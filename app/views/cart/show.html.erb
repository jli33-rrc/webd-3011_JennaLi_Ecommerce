<section class="section">
  <div class="container">
    <h1 class="title is-2 has-text-dark">Shopping Cart</h1>

    <% if session[:cart].empty? %>
      <p>Your cart is empty.</p>
      <%= link_to "Continue Shopping", root_path, class: "button is-dark is-rounded mt-4" %>
    <% else %>

    <table class="table is-fullwidth is-striped">
      <thead>
        <tr>
          <th>Image</th>
          <th>Product</th>
          <th>Price</th>
          <th>Qty</th>
          <th>Total</th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% @cart_items.each do |product| %>
          <% qty = session[:cart][product.id.to_s] %>
          <tr>
            <td style="width:120px">
              <% if product.image.attached? %>
                <%= image_tag product.image.variant(resize_to_limit: [120,120]) %>
              <% end %>
            </td>

            <td><%= product.product_name %></td>
            <td>$<%= product.price %></td>

            <td>
              <%= form_with url: update_cart_item_path(product.id),
                            method: :patch,
                            local: true do %>
                <%= number_field_tag :quantity, qty, min: 1,
                     class: "input", style: "width:80px" %>

                <%= submit_tag "Update",
                     class: "button is-small is-info mt-1" %>
              <% end %>
            </td>

            <td>$<%= product.price * qty %></td>

            <td>
              <%= button_to "Remove",
                    remove_cart_item_path(product.id),
                    method: :delete,
                    class: "button is-small is-danger is-light" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% grand_total = @cart_items.sum { |item|
      item.price * session[:cart][item.id.to_s]
    } %>

    <h2 class="title is-4 mt-4">Grand Total: $<%= grand_total %></h2>

    <%= link_to "Continue Shopping", root_path,
          class: "button is-dark is-rounded mt-4" %>

    <% end %>
  </div>
</section>
